{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "sourceUrl": "Source menu page",
        "name": "Menu item name",
        "description": "Menu item description",
        "price": "Menu item price",
        "category": "Menu section",
        "imageUrl": "HTTPS URL for the menu item's photo, when available"
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["name", "description", "price", "category", "imageUrl", "sourceUrl"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "name": { "label": "Item", "format": "text" },
                    "description": { "label": "Description", "format": "text" },
                    "price": { "label": "Price", "format": "text" },
                    "category": { "label": "Category", "format": "text" },
                    "imageUrl": { "label": "Photo URL", "format": "link" },
                    "sourceUrl": { "label": "Source URL", "format": "link" }
                }
            }
        }
    }
}
